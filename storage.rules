rules_version = '2';

// Documentation: https://firebase.google.com/docs/storage/security
service firebase.storage {
  match /b/{bucket}/o { // Match the bucket

    // Profile Pictures: Allow public read, authenticated write to own folder
    match /profilePictures/{userId}/{fileName} {
      // Allow anyone to read profile pictures
      // Consider changing to `if request.auth != null;` if privacy is needed
      allow read;

      // Allow write (upload, update, delete) only if user is authenticated
      // and the userId in the path matches the user's UID.
      // Also check file type and size.
      allow write: if request.auth != null 
                     && request.auth.uid == userId 
                     && request.resource.size < 2 * 1024 * 1024 // Max 2MB
                     && request.resource.contentType.matches('image/.*'); // Only allow images
    }

    // Add rules for other paths as needed
    // e.g., match /otherFiles/{allPaths=**} { allow read, write: if <condition>; }

    // By default, deny access to other paths if no rules match

  }
} 